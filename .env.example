# Copy to .env (local) or add these in Vercel -> Project -> Settings -> Environment Variables.
# Values come from your Lovable Cloud backend (Project Settings -> Backend).
# All six are the same three values, once for the browser and once for the server.

# Used by the browser (must keep the VITE_ prefix)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Used by the server (same values, no VITE_ prefix)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="your-project-id"

# Only needed if you want Vercel's build to target Vercel explicitly.
# Vercel normally detects this on its own, so you can leave this out.
# NITRO_PRESET="vercel"

# No service-role / admin database key is needed: admin role changes run
# through a database function that checks the signed-in user is an admin.
